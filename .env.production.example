# 建议至少 32 字符随机串，例如：openssl rand -base64 32
# 必填：否则无法安全签发 JWT
JWT_SECRET=REQUIRED_SET_SECURE_RANDOM_STRING # e.g. openssl rand -base64 32
INIT_ADMIN_EMAIL=admin@example.com
# 必填：请设置强密码
INIT_ADMIN_PASSWORD=REQUIRED_SET_STRONG_PASSWORD # minimum 12 chars incl. letters, numbers, symbols

# 可选：RAG（硅基流动）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
SILICONFLOW_HTTP_TIMEOUT=240
