DATABASE_URL=postgresql+psycopg://szu:szu@localhost:5432/szu_memoir
JWT_SECRET=replace-with-long-random-string
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 可选：平面图标注 JSON 绝对路径；不填则使用 backend/data/annotations.json 或仓库 frontend/public/annotations.json
# ANNOTATIONS_JSON_PATH=

# 硅基流动（OpenAI 兼容）；也可在管理员「API 设置」写入库
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
# 访问硅基流动单次读超时（秒），网络慢或 Docker DNS 慢时可调大，如 300
SILICONFLOW_HTTP_TIMEOUT=240
SILICONFLOW_MAX_RETRIES=1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_DIMENSION=1024

INIT_ADMIN_EMAIL=admin@szu.local
INIT_ADMIN_PASSWORD=admin123456
